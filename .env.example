# Copy to .env (never commit .env). Loaded via `node --env-file-if-exists`;
# in Docker/CI set real environment variables instead. Empty values mean "use the default".

# --- Database (required) ---
DATABASE_URL=postgres://relay:CHANGE_ME@localhost:5432/relay
# Used only by `npm test -w server`. Database name MUST end in _test (tests truncate tables).
TEST_DATABASE_URL=postgres://relay:CHANGE_ME@localhost:5432/relay_test
# Server-side safety nets for API/worker pools (the migration runner does not use them).
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=10000

# --- API ---
API_HOST=0.0.0.0
API_PORT=3000
MAX_PAYLOAD_BYTES=262144

# --- Worker ---
# WORKER_ID defaults to <hostname>-<pid>
WORKER_ID=
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=500
# Must be >= 2 * HTTP_TIMEOUT_MS + 5000 (validated at startup)
LEASE_MS=30000
SWEEP_INTERVAL_MS=5000
HTTP_TIMEOUT_MS=10000

# --- Retries ---
RETRY_BASE_MS=2000
RETRY_CAP_MS=600000
MAX_ATTEMPTS=6

# --- Circuit breaker ---
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# --- Security (keep false outside local development) ---
# true lets the worker call localhost/private IPs (needed for the local mock consumer)
RELAY_ALLOW_PRIVATE_NETWORKS=false
# true allows http:// endpoint URLs (needed for the local mock consumer)
ALLOW_HTTP_ENDPOINTS=false

# --- Logging: fatal | error | warn | info | debug | trace | silent ---
LOG_LEVEL=info
